{% extends 'base.html.twig' %}

{% block title %}Photos index{% endblock %}

{% block body %}
    {{ include('menu/index.html.twig') }}

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8 d-flex flex-wrap gap-3">
                {% for photo in photos %}
                    <div class="card" style="width: 18rem;">
                        <img src="{{ asset('uploads/photos/' ~ photo.nomFichier) }}" class="card-img-top" alt="...">
                        <div class="card-body">
                            <h5 class="card-title">{{ photo.nomFichier }}</h5>
                            <p class="card-text">{{ photo.etatOeuvre }}</p>
                        </div>
                    </div>
                {% else %}
                    <p>Aucune photo pour l'instant</p>
                {% endfor %}
            </div>
            <div class="col-md-4">
                <img src="{{ asset('media/accueil.png') }}" class="img-fluid" alt="">
            </div>
        </div>
    </div>
    <a class="btn btn-primary" href="{{ path('app_photos_new') }}">Ajouter</a>
{% endblock %}
