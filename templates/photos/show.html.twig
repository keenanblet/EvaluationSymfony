{% extends 'base.html.twig' %}

{% block title %}Photos{% endblock %}

{% block body %}
    <h1>Photos</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ photo.id }}</td>
            </tr>
            <tr>
                <th>DatePriseVue</th>
                <td>{{ photo.datePriseVue ? photo.datePriseVue|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>NomFichier</th>
                <td>
                    {{ photo.nomFichier }}
                    {% if photo.nomFichier %}
                        <br><img src="{{ asset('uploads/photos/' ~ photo.nomFichier) }}" alt="{{ photo.nomFichier }}" style="max-width: 400px;">
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>EtatOeuvre</th>
                <td>{{ photo.etatOeuvre }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_photos_index') }}">back to list</a>

    <a href="{{ path('app_photos_edit', {'id': photo.id}) }}">edit</a>

    {{ include('photos/_delete_form.html.twig') }}
{% endblock %}
