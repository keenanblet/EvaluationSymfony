{% extends 'base.html.twig' %}

{% block title %}Artiste index{% endblock %}

{% block body %}
    <h1>Les Artistes</h1>
    <div class="row g-4">
        {% for artiste in artistes %}
        <div class="col-md-3">
            <div class="card" style="width: 18rem;">
                <div class="card-body">
                    <div class="rounded-circle bg-secondary mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">{{  artiste.pseudonyme |slice(0, 1) }}</div>
                    <h5 class="card-title">{{ artiste.pseudonyme }}</h5>
                    <p class="card-subtitle text-muted">{{ artiste.nomReel }}</p>
                    <p class="card-text">{{ artiste.bio }}</p>
                    <a href="{{ path('app_artiste_show', {'id': artiste.id}) }}" class="btn btn-primary">Voir</a>
                </div>
            </div>
        </div>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>

        {% endfor %}
    </div>
{% endblock %}
