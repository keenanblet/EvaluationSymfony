{% extends 'base.html.twig' %}

{% block title %}{{ artiste.pseudonyme }}{% endblock %}

{% block body %}
<div class="container py-4">
    <a href="{{ path('app_artiste_index') }}" class="text-decoration-none small">
        <i class="bi bi-arrow-left"></i> Retour aux artistes
    </a>

    {# En-tête de l'artiste #}
    <div class="d-flex align-items-center gap-4 my-4">
        <div class="rounded-circle bg-primary text-white fs-1 fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 110px; height: 110px;">
            {{ artiste.pseudonyme|slice(0, 1)|upper }}
        </div>
        <div>
            <h1 class="fw-bold mb-1">{{ artiste.pseudonyme }}</h1>
            <p class="text-muted mb-2">{{ artiste.nomReel }}</p>
            {% if artiste.nationalite %}
                <span class="badge rounded-pill text-bg-secondary">
                    <i class="bi bi-globe"></i> {{ artiste.nationalite }}
                </span>
            {% endif %}
        </div>
    </div>

    {% if artiste.bio %}
        <p class="lead border-start border-primary border-3 ps-3 mb-5">{{ artiste.bio }}</p>
    {% endif %}

    {# Oeuvres de l'artiste #}
    <h2 class="h4 mb-3">Ses oeuvres <span class="text-muted">({{ artiste.oeuvres|length }})</span></h2>
    <div class="row g-4">
        {% for oeuvre in artiste.oeuvres %}
            {% set photo = oeuvre.photos|first %}
            <div class="col-sm-6 col-lg-4">
                <a href="{{ path('app_oeuvre_show', {'id': oeuvre.id}) }}" class="card h-100 text-decoration-none">
                    {% if photo %}
                        <img src="{{ asset('uploads/photos/' ~ photo.nomFichier) }}" class="card-img-top" style="height: 220px; object-fit: cover;" alt="{{ oeuvre.titre }}">
                    {% else %}
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 220px;">
                            <i class="bi bi-image fs-1 text-muted"></i>
                        </div>
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title mb-0">{{ oeuvre.titre }}</h5>
                    </div>
                </a>
            </div>
        {% else %}
            <p class="text-muted">Aucune oeuvre pour cet artiste.</p>
        {% endfor %}
    </div>

    {% if is_granted('ROLE_BENEVOLE') %}
        <div class="d-flex gap-2 mt-5">
            <a href="{{ path('app_artiste_edit', {'id': artiste.id}) }}" class="btn btn-outline-primary">
                <i class="bi bi-pencil"></i> Modifier
            </a>
            {{ include('artiste/_delete_form.html.twig') }}
        </div>
    {% endif %}
</div>
{% endblock %}
