<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}ArtDeRue{% endblock %}</title>

        {% block stylesheets %}
            <!-- CDN Bootstrap 5 + icônes -->
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
            <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
        {% endblock %}

        {% block javascripts %}
            <!-- JS Bootstrap 5 (dans le head avec defer pour ne pas être rechargé à chaque navigation Turbo) -->
            <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
            {# charge assets/app.js et assets/styles/app.css (thème perso) via AssetMapper #}
            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body>
        {{ include('menu/index.html.twig') }}

        <div>
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
