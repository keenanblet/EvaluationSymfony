{% extends 'base.html.twig' %}

{% block title %}Les oeuvres{% endblock %}

{% block body %}
    {{ include('menu/index.html.twig') }}

    <div class="container-fluid">
        <h1 class="mb-4">Les oeuvres</h1>

        {# "galerie" est défini dans assets/styles/app.css : il range les cartes en colonnes #}
        <div class="galerie">
            {% for oeuvre in oeuvres %}
                {% set photo = oeuvre.photos|first %}

                <div class="card">
                    {% if photo %}
                        <img src="{{ asset('uploads/photos/' ~ photo.nomFichier) }}" class="card-img-top" alt="{{ oeuvre.titre }}">
                    {% endif %}
                    <div class="card-body">
                        <h5 class="card-title">{{ oeuvre.titre }}</h5>
                        <a href="{{ path('app_oeuvre_show', {id: oeuvre.id}) }}" class="btn btn-primary btn-sm">Voir</a>
                    </div>
                </div>
            {% else %}
                <p>Aucune oeuvre pour l'instant</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
